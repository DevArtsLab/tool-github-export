{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DevArtsLab/tool-github-export/main/schemas/repos.schema.json",
  "title": "github-export repository export",
  "description": "Stable contract for repos.public.json and repos.private.json produced by tool-github-export. schema_version follows semver: breaking changes bump the major version.",
  "type": "object",
  "required": ["schema_version", "generated_at", "generator", "sources", "stats", "repositories"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "login"],
        "properties": {
          "type": { "enum": ["user", "organization"] },
          "login": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "required": ["total", "public", "private", "by_category"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "public": { "type": "integer", "minimum": 0 },
        "private": { "type": "integer", "minimum": 0 },
        "by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "language": {
      "type": "object",
      "required": ["name", "bytes", "percentage"],
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["tag"],
      "properties": {
        "tag": { "type": "string" },
        "published_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "name", "full_name", "owner", "owner_type", "url", "visibility",
        "category", "featured", "tags", "languages", "stars", "forks",
        "watchers", "open_issues", "size_kb", "is_fork", "is_archived",
        "is_template", "default_branch"
      ],
      "properties": {
        "name": { "type": "string" },
        "full_name": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "owner": { "type": "string" },
        "owner_type": { "enum": ["User", "Organization"] },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "homepage": { "type": "string" },
        "visibility": { "enum": ["public", "internal", "private"] },
        "category": {
          "type": "string",
          "description": "Stable filter field derived from name prefix (see export.config.yaml categories). Examples: tool, org-infra, project."
        },
        "featured": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "GitHub topics plus override tags, sorted, deduplicated."
        },
        "primary_language": { "type": "string" },
        "languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/language" }
        },
        "license": { "type": "string" },
        "stars": { "type": "integer", "minimum": 0 },
        "forks": { "type": "integer", "minimum": 0 },
        "watchers": { "type": "integer", "minimum": 0 },
        "open_issues": { "type": "integer", "minimum": 0 },
        "size_kb": { "type": "integer", "minimum": 0 },
        "is_fork": { "type": "boolean" },
        "is_archived": { "type": "boolean" },
        "is_template": { "type": "boolean" },
        "forked_from": { "type": "string" },
        "default_branch": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "pushed_at": { "type": "string", "format": "date-time" },
        "latest_release": { "$ref": "#/$defs/release" },
        "image_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  }
}
